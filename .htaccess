# Apache Configuration for FASAL Web Application
RewriteEngine On
RewriteBase /

# Force HTTPS in production (if available)
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hide .php extension from URLs
# 1. Redirect /file.php to /file (unless it's an internal redirect or POST request)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^ %1 [R=301,L]

# 2. Internally rewrite /file to /file.php if file.php exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Prevent directory browsing
Options -Indexes

# Protect sensitive configuration files
<FilesMatch "^(config\.php|database\.php|\.env|\.git|\.htaccess)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Allow API and direct PHP calls
<FilesMatch "(index\.php|dashboard\.php|auth\.php|advisory\.php|mandi\.php|community\.php|schemes\.php|profile\.php|get-data\.php|post-data\.php|iot-sync\.php|weather\.php|gemini-ai\.php|mandi-data\.php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
